# ─── ECO-IA Environment Configuration ───────────────────────────────────────
# Copy this file to .env and fill in your values.

# ── API Authentication ────────────────────────────────────────────────────────
ECO_IA_API_KEY=change-me-api-key
ECO_IA_ADMIN_KEY=change-me-admin-key

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: openai | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ── Server ────────────────────────────────────────────────────────────────────
API_PORT=8000
API_WORKERS=1
DEBUG=false
CORS_ORIGINS=*

# ── Backups (Hetzner Storage Box) ─────────────────────────────────────────────
HETZNER_STORAGE_BOX_HOST=u123456.your-storagebox.de
HETZNER_STORAGE_BOX_USER=u123456
HETZNER_STORAGE_BOX_PASS=your-password

# ── Monitoring ────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
ALERT_EMAILS=admin@yourdomain.com
